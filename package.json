{
  "name": "@ferrianes/gemini-mcp",
  "version": "0.1.1",
  "description": "Local MCP server that drives gemini.google.com with Brave Profile 1 automation (supporting 4 Argon and Pro models)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "gemini-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "gemini",
    "argon",
    "playwright",
    "brave"
  ],
  "author": "Ferriannn",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
